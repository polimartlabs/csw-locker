# ============================================================================
# CSW Locker — ui-v3 environment template
# ----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values for your environment.
# `.env.local` is git-ignored (matches *.local) so secrets never leave your box.
#
# Vite only exposes variables prefixed with `VITE_` to the browser bundle.
# ============================================================================

# ---------------------------------------------------------------------------
# Platform fee (CSW Smart Wallet treasury)
# ---------------------------------------------------------------------------
# The fee is FAIL-OPEN: if no treasury address is set for the active network,
# the fee is silently skipped. We never route funds to a placeholder.
#
# Fee math: feeSats = clamp(amountSats * BPS / 10_000, MIN_SATS, CAP_SATS)
# ---------------------------------------------------------------------------

# Basis points (10 = 0.10%, 25 = 0.25%, 100 = 1.00%). Set to 0 to disable.
VITE_CSW_FEE_BPS=10

# Minimum fee in sats (also acts as a dust floor). P2WPKH dust == 294 sats.
VITE_CSW_FEE_MIN_SATS=546

# Cap in sats so large spends aren't taxed disproportionately.
VITE_CSW_FEE_CAP_SATS=50000

# Treasury addresses per network. Leave blank to disable the fee on that net.
# Use a SegWit (bc1…/tb1…) address so the extra output is cheap (P2WPKH dust = 294).
VITE_CSW_TREASURY_BTC_MAINNET=
VITE_CSW_TREASURY_BTC_TESTNET=

# STX treasury (reserved — not yet wired into STX flows).
VITE_CSW_TREASURY_STX=
